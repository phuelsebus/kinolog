---
import { Image } from 'astro:assets';
import WaitlistForm from './islands/WaitlistForm';
import PhoneMockup from './PhoneMockup.astro';
import libraryScreenshot from '../assets/screenshots/library.png';
---

<section class="relative overflow-hidden px-6 pb-20 pt-16 md:pb-32 md:pt-24">
  <!-- Warmer Glow-Hintergrund, angelehnt an den Feature-Graphic (dunkelbraune
       Flaeche rechts) - reines CSS, kein Bild noetig. -->
  <div
    class="pointer-events-none absolute -right-40 top-0 h-[600px] w-[600px] rounded-full bg-glow blur-3xl md:-right-20"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-16 md:grid-cols-2">
    <div>
      <span class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-ember">
        Bald verfügbar
      </span>
      <h1 id="hero-heading" class="mt-4 text-5xl font-extrabold tracking-tight text-cream sm:text-6xl">
        Jeder Kinobesuch, gesammelt an einem Ort.
      </h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-mist">
        KinoLiebe ist dein persönliches Kino-Tagebuch: Filme, Kinos, Bewertungen und Original-Tickets in einer
        durchsuchbaren Bibliothek – statt loser Ticketstapel in der Schublade.
      </p>

      <div id="warteliste" class="mt-8 max-w-md scroll-mt-24">
        <WaitlistForm client:visible variant="hero" />
        <p class="mt-3 text-xs text-mist/70">
          Wir schicken dir eine Nachricht, sobald die App im Play Store steht. Kein Spam.
        </p>
      </div>
    </div>

    <div data-reveal>
      <PhoneMockup src={libraryScreenshot} alt="KinoLiebe Bibliothek mit geloggten Kinobesuchen" priority />
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);

  const heading = document.getElementById('hero-heading');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (heading && !prefersReducedMotion) {
    const split = new SplitText(heading, { type: 'words' });
    gsap.from(split.words, {
      opacity: 0,
      y: 16,
      duration: 0.5,
      stagger: 0.04,
      ease: 'power2.out',
    });
  }
</script>
