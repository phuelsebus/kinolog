---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  priority?: boolean;
}

const { src, alt, class: className = '', priority = false } = Astro.props;
---

<div class:list={['relative mx-auto w-full max-w-[280px]', className]}>
  <div class="relative rounded-[2.5rem] border-4 border-white/10 bg-glow p-2 shadow-2xl shadow-black/50">
    <div class="overflow-hidden rounded-[2rem]">
      <Image
        src={src}
        alt={alt}
        width={420}
        height={900}
        loading={priority ? 'eager' : 'lazy'}
        class="w-full"
      />
    </div>
    <div class="absolute left-1/2 top-3 h-1.5 w-16 -translate-x-1/2 rounded-full bg-black/40"></div>
  </div>
</div>
