---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden – KinoLiebe" description="Diese Seite gibt es nicht.">
  <div class="mx-auto flex max-w-lg flex-col items-center px-6 py-32 text-center">
    <h1 class="text-4xl font-extrabold text-cream">404</h1>
    <p class="mt-3 text-mist">Diese Seite gibt es nicht (mehr).</p>
    <a href="/" class="mt-6 rounded-full bg-ember px-6 py-3 font-semibold text-cream hover:bg-ember-light">
      Zur Startseite
    </a>
  </div>
</BaseLayout>
