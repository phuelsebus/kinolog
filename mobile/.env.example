# Supabase Projekt-URL und Public Anon Key (unbedenklich im Client, RLS schuetzt Daten)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry DSN (Fehler-/Crash-Tracking) - DSNs sind bewusst oeffentlich lesbar
# gestaltet (kein Secret), sicher im Client-Bundle. Projekt: phnx-vn/kinolog.
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXXXX.ingest.de.sentry.io/XXXXXXX
