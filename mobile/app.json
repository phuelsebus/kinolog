{
  "expo": {
    "name": "KinoLiebe",
    "slug": "kinolog",
    "scheme": "kinolog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kinolog.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "KinoLiebe benötigt Kamerazugriff, um Kinokarten zu fotografieren.",
        "NSPhotoLibraryUsageDescription": "KinoLiebe benötigt Zugriff auf deine Fotos, um Kinokarten oder ein Profilbild zu importieren."
      }
    },
    "android": {
      "package": "app.kinolog.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#17150F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "KinoLiebe benötigt Kamerazugriff, um Kinokarten zu fotografieren.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KinoLiebe benötigt Zugriff auf deine Fotos, um Kinokarten oder ein Profilbild zu importieren.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aba0d81f-9a7a-4671-a64f-23d074e7fade"
      }
    },
    "owner": "phuelsebusxx"
  }
}
