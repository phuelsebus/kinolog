{
  "expo": {
    "name": "kinolog",
    "slug": "kinolog",
    "scheme": "kinolog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kinolog.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "KinoLog benötigt Kamerazugriff, um Kinokarten zu fotografieren.",
        "NSPhotoLibraryUsageDescription": "KinoLog benötigt Zugriff auf deine Fotos, um Kinokarten zu importieren."
      }
    },
    "android": {
      "package": "app.kinolog.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "KinoLog benötigt Kamerazugriff, um Kinokarten zu fotografieren."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KinoLog benötigt Zugriff auf deine Fotos, um Kinokarten zu importieren."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aba0d81f-9a7a-4671-a64f-23d074e7fade"
      }
    },
    "owner": "phuelsebusxx"
  }
}
